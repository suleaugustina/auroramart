{
  "name": "auroramart",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "bots"
  ],
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:convex": "cd frontend && npx convex dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && npm install && cd ../bots && npm install",
    "bots:run": "cd bots && npm run start",
    "bots:load": "cd bots && npm run load-test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "convex": "^1.39.1"
  }
}
