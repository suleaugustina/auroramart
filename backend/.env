# App
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Convex
CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOY_KEY=prod:your-deploy-key

# JWT - generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_THIS_LONG_RANDOM_STRING_64_CHARS_MINIMUM
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=DIFFERENT_LONG_RANDOM_STRING_64_CHARS_MINIMUM
JWT_REFRESH_EXPIRES_IN=7d

# Paystack - get from: dashboard.paystack.com > Settings > API Keys
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret

# Email (SMTP)
# Gmail: enable 2FA > App Passwords > generate
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM="AuroraMart <noreply@auroramart.com>"

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Bot simulator
BOT_CONVEX_URL=https://your-deployment.convex.cloud
